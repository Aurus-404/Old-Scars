  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::OldScars.Core.Interactions.WorldObjectDebugInfo
  displayName: Contenedor sellado de mantenimiento
  inspectText: La tapa esta sellada y torcida. Parece forzable con una palanca.
  conditionalInspectionTexts:
  - priority: 10
    requiredTags:
    - sealed_container
    forbiddenTags: []
    displayName: Contenedor sellado de mantenimiento
    inspectText: La tapa esta sellada y torcida. El contenedor existe y puede tener
      contenido, pero todavia no se puede acceder.
  - priority: 20
    requiredTags:
    - opened_container
    - lootable_container
    forbiddenTags:
    - looted_container
    displayName: Contenedor abierto de mantenimiento
    inspectText: La tapa esta abierta. Dentro podria quedar material util para revisar.
  - priority: 30
    requiredTags:
    - looted_container
    forbiddenTags: []
    displayName: Contenedor saqueado
    inspectText: El contenedor ya fue revisado. No queda nada util a simple vista.
