  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::OldScars.Core.Interactions.WorldObjectDebugInfo
  displayName:
  inspectText: La puerta esta trabada por oxido. Una herramienta de palanca podria
    forzarla.
  conditionalInspectionTexts:
  - priority: 10
    requiredTags:
    - locked_door
    forbiddenTags:
    - forced_open
    - closed_door
    - opened_door
    displayName: Puerta bloqueada
    inspectText: La puerta esta bloqueada. Una herramienta de palanca podria forzarla.
  - priority: 15
    requiredTags:
    - closed_door
    forbiddenTags:
    - locked_door
    - forced_open
    - opened_door
    displayName: Puerta cerrada
    inspectText: La puerta esta cerrada, pero no bloqueada. Se puede abrir normalmente.
  - priority: 20
    requiredTags:
    - opened_door
    forbiddenTags:
    - locked_door
    - closed_door
    displayName: Puerta abierta
    inspectText: La puerta esta abierta y ya no bloquea el paso.
  - priority: 5
    requiredTags:
    - forced_open
    forbiddenTags:
    - locked_door
    - closed_door
    - opened_door
    displayName: Puerta forzada legacy
    inspectText: La puerta quedo forzada por el flujo legacy. Para M32.2 el estado
      canonico abierto es opened_door.
